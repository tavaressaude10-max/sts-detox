# Copie apenas para .env.commerce.local, que não é versionado.
# Nunca use prefixo VITE_ em credenciais. Padrão seguro: teste local.
COMMERCE_MODE=test
COMMERCE_SITE_ORIGIN=http://127.0.0.1:5174
# Chave de 32 bytes hexadecimais, gerada localmente pelo comando commerce:setup.
COMMERCE_DATA_KEY=
# Access Token obtido no seletor TESTE da aplicação Mercado Pago.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_TEST_SELLER_ID=
MERCADOPAGO_WEBHOOK_SECRET=
# Origem HTTPS de teste para retorno. Não usar o domínio de produção.
# Precisa servir a mesma aplicação/sessão. Nenhum túnel é iniciado automaticamente.
MERCADOPAGO_TEST_RETURN_ORIGIN=
# Token de SANDBOX SuperFrete. Variáveis antigas continuam aceitas só em teste.
SUPERFRETE_TOKEN=
# Nomes explícitos opcionais substituem os legados acima em teste.
MERCADOPAGO_TEST_ACCESS_TOKEN=
MERCADOPAGO_TEST_WEBHOOK_SECRET=
SUPERFRETE_TEST_TOKEN=

# Produção: preencher SOMENTE no ambiente privado do servidor, após homologação.
# COMMERCE_MODE=production
# COMMERCE_SITE_ORIGIN=https://dominio-confirmado.example
COMMERCE_PRODUCTION_CHECKOUT_ENABLED=false
COMMERCE_PRODUCTION_DATA_KEY=
MERCADOPAGO_PRODUCTION_ACCESS_TOKEN=
MERCADOPAGO_PRODUCTION_SELLER_ID=
MERCADOPAGO_PRODUCTION_WEBHOOK_SECRET=
SUPERFRETE_PRODUCTION_TOKEN=
# Retorno de produção usa COMMERCE_SITE_ORIGIN, preservando a sessão.
# Node público: HOST=0.0.0.0 somente atrás do proxy HTTPS da hospedagem.
HOST=127.0.0.1
PORT=3000
ASSISTANT_ENABLED=false
# Desativado até configurar remetente/provedor; fila privada é preservada.
EMAIL_DELIVERY=disabled
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Servidor e cron: MySQL é o padrão. file é permitido SOMENTE para teste local.
COMMERCE_STORAGE=mysql
MYSQL_TEST_HOST=127.0.0.1
MYSQL_TEST_PORT=3306
MYSQL_TEST_DATABASE=
MYSQL_TEST_USER=
MYSQL_TEST_PASSWORD=
MYSQL_TEST_TLS=false
MYSQL_PRODUCTION_HOST=127.0.0.1
MYSQL_PRODUCTION_PORT=3306
MYSQL_PRODUCTION_DATABASE=
MYSQL_PRODUCTION_USER=
MYSQL_PRODUCTION_PASSWORD=
MYSQL_PRODUCTION_TLS=false
# Host remoto exige TLS=true; use o host fornecido pela hospedagem.
# Cron usa as mesmas variáveis privadas do servidor. Não as herda automaticamente.
EMAIL_CRON_SEND=false
